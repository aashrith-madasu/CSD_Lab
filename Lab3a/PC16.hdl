CHIP PC16 {
    IN in[16],load,inc0,inc1,reset;
    OUT out[16];

    PARTS:

    Inc16(in=feedback, out=incout1);
	Add16(a[1]=true,b=feedback, out=incout2);
	Add16(a[0]=true, a[1]=true,b=feedback, out=incout3);

	Mux16(a=feedback, b=incout1, sel=inc0, out=out1);
	Mux16(a=incout2, b=incout3, sel=inc0, out=out2);
	Mux16(a=out1, b=out2, sel=inc1, out=m);

    Mux16(a=m, b=in, sel=load, out=m2);
    Mux16(a=m2, b=false, sel=reset, out=m3);

    Reg16Bit(in=m3, load=true, out=feedback, out=out);
}
