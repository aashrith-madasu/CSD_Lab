



CHIP Counter {
    IN up, load, in[8];
    OUT out[8];

    PARTS:
     
    //JKFF(j=true, k=true, q=qa, q=out[0]);
    JKFF(j=j0, k=k0, q=qa, q=out[0]);
    Not(in=qa, out=qabar);
    And(a=up, b=qa, out=w1);
    Not(in=up, out=upbar);
    And(a=qabar, b=upbar, out=w2);
    Or(a=w1, b=w2, out=w3);

    //JKFF(j=w3, k=w3, q=qb, q=out[1]);
    JKFF(j=j1, k=k1, q=qb, q=out[1]);
    Not(in=qb, out=qbbar);
    And(a=qb, b=w1, out=w4);
    And(a=qbbar, b=w2, out=w5);
    Or(a=w4, b=w5, out=w6);

    //JKFF(j=w6, k=w6, q=qc, q=out[2]);
    JKFF(j=j2, k=k2, q=qc, q=out[2]);
    Not(in=qc, out=qcbar);
    And(a=qc, b=w4, out=w7);
    And(a=qcbar, b=w5, out=w8);
    Or(a=w7, b=w8, out=w9);
    
    //JKFF(j=w9, k=w9, q=qd, q=out[3]);
    JKFF(j=j3, k=k3, q=qd, q=out[3]);
    Not(in=qd, out=qdbar);
    And(a=qd, b=w7, out=w10);
    And(a=qdbar, b=w8, out=w11);
    Or(a=w10, b=w11, out=w12);
    
    //JKFF(j=w12, k=w12, q=qe, q=out[4]);
    JKFF(j=j4, k=k4, q=qe, q=out[4]);
    Not(in=qe, out=qebar);
    And(a=qe, b=w10, out=w13);
    And(a=qebar, b=w11, out=w14);
    Or(a=w13, b=w14, out=w15);

    //JKFF(j=w15, k=w15, q=qf, q=out[5]);
    JKFF(j=j5, k=k5, q=qf, q=out[5]);
    Not(in=qf, out=qfbar);
    And(a=qf, b=w13, out=w16);
    And(a=qfbar, b=w14, out=w17);
    Or(a=w16, b=w17, out=w18);
    
    //JKFF(j=w18, k=w18, q=qg, q=out[6]);
    JKFF(j=j6, k=k6, q=qg, q=out[6]);
    Not(in=qg, out=qgbar);
    And(a=qg, b=w16, out=w19);
    And(a=qgbar, b=w17, out=w20);
    Or(a=w19, b=w20, out=w21);

    //JKFF(j=w21, k=w21, q=qh, q=out[7]);
    JKFF(j=j7, k=k7, q=qh, q=out[7]);
    Not(in=qh, out=qhbar);
    And(a=qh, b=w19, out=w22);
    And(a=qhbar, b=w20, out=w23);
    Or(a=w22, b=w23, out=w24);


    Mux(a=true, b=in[0], sel=load, out=j0);
    Xor(a=j0, b=load, out=k0);
    
    Mux(a=w3, b=in[1], sel=load, out=j1);
    Xor(a=j1, b=load, out=k1);

    Mux(a=w6, b=in[2], sel=load, out=j2);
    Xor(a=j2, b=load, out=k2);
    
    Mux(a=w9, b=in[3], sel=load, out=j3);
    Xor(a=j3, b=load, out=k3);

    Mux(a=w12, b=in[4], sel=load, out=j4);
    Xor(a=j4, b=load, out=k4);

    Mux(a=w15, b=in[5], sel=load, out=j5);
    Xor(a=j5, b=load, out=k5);

    Mux(a=w18, b=in[6], sel=load, out=j6);
    Xor(a=j6, b=load, out=k6);
    
    Mux(a=w21, b=in[7], sel=load, out=j7);
    Xor(a=j7, b=load, out=k7);
}