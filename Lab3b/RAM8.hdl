
// RAM with 8 registers of 16-bit word length


CHIP RAM8 {

    IN address[3], load, in[16];
    OUT out[16];

    PARTS:
    DMux8Way(in=load, sel=address, a=l0, b=l1, c=l2, d=l3, e=l4, f=l5, g=l6, h=l7);

    Reg16Bit(in=in, load=l0, out=r0);
    Reg16Bit(in=in, load=l1, out=r1);
    Reg16Bit(in=in, load=l2, out=r2);
    Reg16Bit(in=in, load=l3, out=r3);
    Reg16Bit(in=in, load=l4, out=r4);
    Reg16Bit(in=in, load=l5, out=r5);
    Reg16Bit(in=in, load=l6, out=r6);
    Reg16Bit(in=in, load=l7, out=r7);

    Mux8Way16(a=r0, b=r1, c=r2, d=r3, e=r4, f=r5, g=r6, h=r7, sel=address, out=out);
}