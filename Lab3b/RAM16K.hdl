CHIP RAM16K
{
	IN address[14], load, in[16];
	OUT out[16];

	PARTS:

	DMux4Way(in=load, sel=address[0..1], a=l0, b=l1, c=l2, d=l3);

	RAM4K(address=address[2..13],load=l0, in=in, out=r0);
	RAM4K(address=address[2..13],load=l1, in=in, out=r1);
	RAM4K(address=address[2..13],load=l2, in=in, out=r2);
	RAM4K(address=address[2..13],load=l3, in=in, out=r3);

	Mux4Way16(a=r0,b=r1, c=r2, d=r3, sel=address[0..1], out=out);
}
