CHIP AddSub16 {
    IN a[16], s, b[16];
    OUT out[16];

    PARTS:
    Xor(a=s, b=b[0], out=bn0);
    Xor(a=s, b=b[1], out=bn1);
    Xor(a=s, b=b[2], out=bn2);
    Xor(a=s, b=b[3], out=bn3);
    Xor(a=s, b=b[4], out=bn4);
    Xor(a=s, b=b[5], out=bn5);
    Xor(a=s, b=b[6], out=bn6);
    Xor(a=s, b=b[7], out=bn7);
    Xor(a=s, b=b[8], out=bn8);
    Xor(a=s, b=b[9], out=bn9);
    Xor(a=s, b=b[10], out=bn10);
    Xor(a=s, b=b[11], out=bn11);
    Xor(a=s, b=b[12], out=bn12);
    Xor(a=s, b=b[13], out=bn13);
    Xor(a=s, b=b[14], out=bn14);
    Xor(a=s, b=b[15], out=bn15);



    FullAdder(a=s,   b=a[0],  c=bn0,  sum=out[0],  carry=c0);
    FullAdder(a=c0,    b=a[1],  c=bn1,  sum=out[1],  carry=c1);
    FullAdder(a=c1,    b=a[2],  c=bn2,  sum=out[2],  carry=c2);
    FullAdder(a=c2,    b=a[3],  c=bn3,  sum=out[3],  carry=c3);
    FullAdder(a=c3,    b=a[4],  c=bn4,  sum=out[4],  carry=c4);
    FullAdder(a=c4,    b=a[5],  c=bn5,  sum=out[5],  carry=c5);
    FullAdder(a=c5,    b=a[6],  c=bn6,  sum=out[6],  carry=c6);
    FullAdder(a=c6,    b=a[7],  c=bn7,  sum=out[7],  carry=c7);
    FullAdder(a=c7,    b=a[8],  c=bn8,  sum=out[8],  carry=c8);
    FullAdder(a=c8,    b=a[9],  c=bn9,  sum=out[9],  carry=c9);
    FullAdder(a=c9,    b=a[10], c=bn10, sum=out[10], carry=c10);
    FullAdder(a=c10,   b=a[11], c=bn11, sum=out[11], carry=c11);
    FullAdder(a=c11,   b=a[12], c=bn12, sum=out[12], carry=c12);
    FullAdder(a=c12,   b=a[13], c=bn13, sum=out[13], carry=c13);
    FullAdder(a=c13,   b=a[14], c=bn14, sum=out[14], carry=c14);
    FullAdder(a=c14,   b=a[15], c=bn15, sum=out[15], carry=cout);
}
